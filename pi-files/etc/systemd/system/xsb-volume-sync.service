[Unit]
Description=Xiaomi Sound Bridge: keep the speakers' volumes in sync (computer, AirPlay, speaker buttons)
After=bluealsa.service xsb-gadget.service
Wants=bluealsa.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/xsb-volume-sync
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
