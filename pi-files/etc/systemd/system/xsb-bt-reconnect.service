[Unit]
Description=Xiaomi Sound Bridge: keep the speaker connected (backed-off reconnect)
After=bluetooth.service bluealsa.service
Wants=bluetooth.service bluealsa.service

[Service]
Type=simple
EnvironmentFile=/etc/xsb/xsb.conf
ExecStart=/usr/local/sbin/xsb-bt-reconnect.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
